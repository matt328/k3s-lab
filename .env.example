# k3s-lab environment configuration
#
# Copy this file to .env.local and edit the values for your environment.
# .env.local is gitignored and must never be committed.
#
#   cp .env.example .env.local
#
# Local scripts and the Vagrantfile use these defaults unless overridden by
# .env.local or the calling environment.

# --- LAN networking -----------------------------------------------------------
# The bridge device on your host that VMs attach to (must already exist).
LAB_BRIDGE=br0

# IPv4 prefix length for your LAN (e.g. 24 for a /24).
LAB_PREFIX=24

# Your LAN gateway.
LAB_GATEWAY=192.168.50.1

# DNS server(s) the VMs should use. Space-separated. The first should be the
# resolver that knows your local zone (lab.home below), if any.
LAB_DNS="192.168.50.210 1.1.1.1"

# DNS search domain for the VMs.
LAB_DOMAIN=lab.home

# Cluster ingress DNS zones. Configure these as wildcard records on your local
# DNS server once MetalLB assigns stable ingress IPs.
CLUSTER_A_DNS_ZONE=a.lab.home
CLUSTER_B_DNS_ZONE=b.lab.home

# MetalLB address pools. These must be unused LAN IPs outside your DHCP pool.
# The first IP in each pool is reserved for that cluster's Traefik ingress.
METALLB_A_POOL=192.168.50.240-192.168.50.244
METALLB_B_POOL=192.168.50.245-192.168.50.249
CLUSTER_A_INGRESS_IP=192.168.50.240
CLUSTER_B_INGRESS_IP=192.168.50.245

# --- Physical VM hosts ---------------------------------------------------------
# HOST_* settings describe where Vagrant creates VMs. HOST_LOCAL is the machine
# running Vagrant. HOST_1 and HOST_2 are optional remote libvirt hosts.
HOST_LOCAL_LABEL=local
HOST_LOCAL_BRIDGE=br0
HOST_LOCAL_VM_VCPUS=4
HOST_LOCAL_VM_MEMORY_MB=4096

# Set true only for a temporary local-only or fallback topology. Keeping these
# off avoids putting worker memory pressure back on the local workstation.
HOST_LOCAL_WORKERS_ENABLED=false

# Disabled by default. When enabled, Vagrant defines cluster-A worker VMs on
# this remote libvirt host.
HOST_1_ENABLED=false
HOST_1_LABEL=host-1
HOST_1_URI=
HOST_1_SSH_PROXY_COMMAND=
HOST_1_BRIDGE=br0
HOST_1_VM_VCPUS=4
HOST_1_VM_MEMORY_MB=6144

# Disabled by default. When enabled, Vagrant defines cluster-B worker VMs on
# this remote libvirt host.
HOST_2_ENABLED=false
HOST_2_LABEL=host-2
HOST_2_URI=
HOST_2_SSH_PROXY_COMMAND=
HOST_2_BRIDGE=br0
HOST_2_VM_VCPUS=4
HOST_2_VM_MEMORY_MB=6144

# --- Cluster node addressing --------------------------------------------------
# Static IPs/MACs assigned to each k3s node. These must be unique, free, outside
# DHCP, and outside the MetalLB pools. The 52:54:00 MAC prefix is reserved for
# KVM. *_HOST links each node to a HOST_* profile.
CLUSTER_A_SERVER_1_IP=192.168.50.100
CLUSTER_A_SERVER_1_MAC=52:54:00:a1:00:01
CLUSTER_A_SERVER_1_HOST=HOST_LOCAL

CLUSTER_B_SERVER_1_IP=192.168.50.102
CLUSTER_B_SERVER_1_MAC=52:54:00:b1:00:01
CLUSTER_B_SERVER_1_HOST=HOST_LOCAL

# Optional local fallback workers, used only when HOST_LOCAL_WORKERS_ENABLED=true.
CLUSTER_A_LOCAL_WORKER_1_IP=192.168.50.101
CLUSTER_A_LOCAL_WORKER_1_MAC=52:54:00:a1:00:02
CLUSTER_A_LOCAL_WORKER_1_HOST=HOST_LOCAL

CLUSTER_B_LOCAL_WORKER_1_IP=192.168.50.103
CLUSTER_B_LOCAL_WORKER_1_MAC=52:54:00:b1:00:02
CLUSTER_B_LOCAL_WORKER_1_HOST=HOST_LOCAL

CLUSTER_A_WORKER_1_IP=192.168.50.104
CLUSTER_A_WORKER_1_MAC=52:54:00:a1:00:11
CLUSTER_A_WORKER_1_HOST=HOST_1

CLUSTER_A_WORKER_2_IP=192.168.50.105
CLUSTER_A_WORKER_2_MAC=52:54:00:a1:00:12
CLUSTER_A_WORKER_2_HOST=HOST_1

CLUSTER_B_WORKER_1_IP=192.168.50.106
CLUSTER_B_WORKER_1_MAC=52:54:00:b1:00:21
CLUSTER_B_WORKER_1_HOST=HOST_2

CLUSTER_B_WORKER_2_IP=192.168.50.107
CLUSTER_B_WORKER_2_MAC=52:54:00:b1:00:22
CLUSTER_B_WORKER_2_HOST=HOST_2

CLUSTER_B_WORKER_3_IP=192.168.50.108
CLUSTER_B_WORKER_3_MAC=52:54:00:b1:00:23
CLUSTER_B_WORKER_3_HOST=HOST_2

# --- k3s ----------------------------------------------------------------------
# Cluster-join secrets. Generate with: openssl rand -hex 32
# Two different tokens so the clusters can't accidentally join each other.
K3S_TOKEN_A=replace-me-with-openssl-rand-hex-32
K3S_TOKEN_B=replace-me-with-openssl-rand-hex-32

# Gateway API CRD release channel installed on each cluster.
GATEWAY_API_VERSION=v1.2.1

# --- GitOps -------------------------------------------------------------------
# Git URL Argo CD watches. Public HTTPS works without credentials.
GITOPS_REPO_URL=replace-me-with-your-gitops-repo-url
GITOPS_REPO_REVISION=main
GITOPS_REPO_PATH=gitops

# GHCR namespace where sample app images are published (your GitHub username
# or org). Used by the app build scripts and the deployment manifests.
GHCR_OWNER=replace-me-with-your-github-owner-or-org

# Repo-local Helm v3 used only for `kubectl kustomize --enable-helm`.
# This avoids conflicts with host Helm v4.
HELM_V3_VERSION=v3.18.6

# --- Linkerd / multicluster ---------------------------------------------------
# Phase 4 is script-managed because Linkerd Helm installs require private
# identity key material that must not be committed to Git.
LINKERD_VERSION=stable-2.14.10
LINKERD_CRDS_CHART_VERSION=1.8.0
LINKERD_CONTROL_PLANE_CHART_VERSION=1.16.11
LINKERD_MULTICLUSTER_CHART_VERSION=30.11.11

# MetalLB IPs reserved for Linkerd multicluster gateways. Keep these inside the
# per-cluster pools and distinct from Traefik's ingress IPs.
LINKERD_GATEWAY_A_IP=192.168.50.241
LINKERD_GATEWAY_B_IP=192.168.50.246

# --- Lab-local artifact registry --------------------------------------------
# Reposilite is deployed to cluster B for OpenAPI/Maven artifacts used by the
# Spring reference apps. The bootstrap script stores the admin token under
# .secrets/ and applies it as a Kubernetes Secret.
ARTIFACT_REGISTRY_CONTEXT=cluster-b
ARTIFACT_REGISTRY_NAMESPACE=artifact-registry
ARTIFACT_REGISTRY_SECRET_NAME=reposilite-bootstrap-token
ARTIFACT_REGISTRY_ADMIN_USER=admin
ARTIFACT_REGISTRY_URL=http://maven.b.lab.home
ARTIFACT_REGISTRY_RELEASES_URL=http://maven.b.lab.home/releases
ARTIFACT_REGISTRY_SNAPSHOTS_URL=http://maven.b.lab.home/snapshots

# --- Lab-local OCI registry ---------------------------------------------------
# The registry is intentionally unauthenticated and HTTP-only for lab use.
# k3s nodes must have this host in /etc/rancher/k3s/registries.yaml; the
# provisioners and scripts/configure-oci-registry-nodes.sh manage that, plus
# an /etc/hosts entry so image pulls do not depend on node DNS.
LAB_OCI_REGISTRY_HOST=registry.b.lab.home
LAB_OCI_REGISTRY_IP=192.168.50.245
OCI_REGISTRY_URL=http://registry.b.lab.home

# --- Script defaults ----------------------------------------------------------
# Defaults used by local CI simulation and traffic-generation scripts. Override
# these in .env.local if you change the lab hostnames or image namespace.
ORDER_API_MAVEN_REPOSITORY_URL=http://maven.b.lab.home/releases
PAYMENT_API_MAVEN_REPOSITORY_URL=http://maven.b.lab.home/releases
ORDER_SERVICE_IMAGE_REPOSITORY=registry.b.lab.home/k3s-lab/order-service
PAYMENT_SERVICE_IMAGE_REPOSITORY=registry.b.lab.home/k3s-lab/payment-service
HTTP_TRAFFIC_URL_TEMPLATE=http://order.a.lab.home/orders/{id}
