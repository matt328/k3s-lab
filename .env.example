# k3s-lab environment configuration
#
# Copy this file to .env.local and edit the values for your environment.
# .env.local is gitignored and must never be committed.
#
#   cp .env.example .env.local
#
# Both the Vagrantfile and the phase scripts source these values.

# --- LAN networking -----------------------------------------------------------
# The bridge device on your host that VMs attach to (must already exist).
LAB_BRIDGE=br0

# IPv4 prefix length for your LAN (e.g. 24 for a /24).
LAB_PREFIX=24

# Your LAN gateway.
LAB_GATEWAY=192.168.50.1

# DNS server(s) the VMs should use. Space-separated. The first should be the
# resolver that knows your local zone (lab.home below), if any.
LAB_DNS="192.168.50.210 1.1.1.1"

# DNS search domain for the VMs.
LAB_DOMAIN=lab.home

# Cluster ingress DNS zones. Configure these as wildcard records on your local
# DNS server once MetalLB assigns stable ingress IPs.
CLUSTER_A_DNS_ZONE=a.lab.home
CLUSTER_B_DNS_ZONE=b.lab.home

# MetalLB address pools. These must be unused LAN IPs outside your DHCP pool.
# The first IP in each pool is reserved for that cluster's Traefik ingress.
METALLB_A_POOL=192.168.50.240-192.168.50.244
METALLB_B_POOL=192.168.50.245-192.168.50.249
CLUSTER_A_INGRESS_IP=192.168.50.240
CLUSTER_B_INGRESS_IP=192.168.50.245

# --- VM addressing ------------------------------------------------------------
# Static IPs assigned to each VM. Must be free on your LAN and outside your
# router's DHCP pool.
VM_A_MASTER_IP=192.168.50.100
VM_A_AGENT_IP=192.168.50.101
VM_B_MASTER_IP=192.168.50.102
VM_B_AGENT_IP=192.168.50.103

# MAC addresses for each VM. The 52:54:00 prefix is reserved for KVM.
# Defaults are fine unless they collide with something on your network.
VM_A_MASTER_MAC=52:54:00:a1:00:01
VM_A_AGENT_MAC=52:54:00:a1:00:02
VM_B_MASTER_MAC=52:54:00:b1:00:01
VM_B_AGENT_MAC=52:54:00:b1:00:02

# --- VM sizing ----------------------------------------------------------------
# Default 4 vCPU / 6 GB per VM. Reduce if your host is RAM-constrained, but
# the full stack (Linkerd + Argo CD + Traefik + LGTM + MinIO + 2 apps) will
# struggle below ~6 GB per node.
VM_VCPUS=4
VM_MEMORY_MB=6144

# --- Optional remote worker host ----------------------------------------------
# Disabled by default. When enabled, Vagrant defines four additional k3s agent
# VMs on a separate libvirt host: two join cluster A and two join cluster B.
# The remote host must be bridged onto the same L2 LAN/subnet as LAB_BRIDGE so
# these agents can reach the local masters and use static LAN IPs.
REMOTE_LIBVIRT_ENABLED=false

# Remote system libvirt URI. Example:
# REMOTE_LIBVIRT_URI=qemu+ssh://matt@idle-host/system
REMOTE_LIBVIRT_URI=

# Required when REMOTE_LIBVIRT_ENABLED=true. Vagrant initially SSHes to guests
# over libvirt's management network, which normally exists only on the remote
# host, so guest SSH needs to be proxied through that host. Example:
# REMOTE_LIBVIRT_SSH_PROXY_COMMAND="ssh -W %h:%p matt@idle-host"
REMOTE_LIBVIRT_SSH_PROXY_COMMAND=

# Bridge name on the remote host. Often br0, but configurable independently of
# the local host.
REMOTE_LAB_BRIDGE=br0

# Remote VM sizing. Defaults match local VM_VCPUS / VM_MEMORY_MB.
REMOTE_VM_VCPUS=4
REMOTE_VM_MEMORY_MB=6144

# Static LAN IPs/MACs for optional remote workers. These must be unique, free,
# outside DHCP, and outside the MetalLB pools.
VM_A_REMOTE_1_IP=192.168.50.104
VM_A_REMOTE_2_IP=192.168.50.105
VM_B_REMOTE_1_IP=192.168.50.106
VM_B_REMOTE_2_IP=192.168.50.107

VM_A_REMOTE_1_MAC=52:54:00:a1:00:11
VM_A_REMOTE_2_MAC=52:54:00:a1:00:12
VM_B_REMOTE_1_MAC=52:54:00:b1:00:11
VM_B_REMOTE_2_MAC=52:54:00:b1:00:12

# --- k3s ----------------------------------------------------------------------
# Cluster-join secrets. Generate with: openssl rand -hex 32
# Two different tokens so the clusters can't accidentally join each other.
K3S_TOKEN_A=replace-me-with-openssl-rand-hex-32
K3S_TOKEN_B=replace-me-with-openssl-rand-hex-32

# Gateway API CRD release channel installed on each cluster.
GATEWAY_API_VERSION=v1.2.1

# --- GitOps -------------------------------------------------------------------
# Git URL Argo CD watches. Public HTTPS works without credentials.
GITOPS_REPO_URL=https://github.com/matt328/k3s-lab.git
GITOPS_REPO_REVISION=main
GITOPS_REPO_PATH=gitops

# GHCR namespace where sample app images are published (your GitHub username
# or org). Used by the app build scripts and the deployment manifests.
GHCR_OWNER=matt328

# Repo-local Helm v3 used only for `kubectl kustomize --enable-helm`.
# This avoids conflicts with host Helm v4.
HELM_V3_VERSION=v3.18.6

# --- Linkerd / multicluster ---------------------------------------------------
# Phase 4 is script-managed because Linkerd Helm installs require private
# identity key material that must not be committed to Git.
LINKERD_VERSION=stable-2.14.10
LINKERD_CRDS_CHART_VERSION=1.8.0
LINKERD_CONTROL_PLANE_CHART_VERSION=1.16.11
LINKERD_MULTICLUSTER_CHART_VERSION=30.11.11

# MetalLB IPs reserved for Linkerd multicluster gateways. Keep these inside the
# per-cluster pools and distinct from Traefik's ingress IPs.
LINKERD_GATEWAY_A_IP=192.168.50.241
LINKERD_GATEWAY_B_IP=192.168.50.246
